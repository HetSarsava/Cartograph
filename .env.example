# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider ---
# Groq is the primary/default provider (free tier available).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Test runner ---
# Timeout (seconds) for a single `run_tests()` invocation.
CARTOGRAPH_TEST_TIMEOUT_SECONDS=120

# --- Logging ---
CARTOGRAPH_LOG_LEVEL=INFO
