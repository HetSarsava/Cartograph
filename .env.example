# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider ---
# Groq is the primary/default provider (free tier available).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Budgets / limits ---
# Reserved advisory setting; no enforced run-wide LLM call budget yet.
CARTOGRAPH_MAX_LLM_CALLS_PER_RUN=25

# Reserved for the deferred context packer; no model token budget is enforced.
CARTOGRAPH_MAX_CONTEXT_TOKENS=8000

# --- Test runner ---
# Timeout (seconds) for a single `run_tests()` invocation.
CARTOGRAPH_TEST_TIMEOUT_SECONDS=120

# --- Logging ---
CARTOGRAPH_LOG_LEVEL=INFO
