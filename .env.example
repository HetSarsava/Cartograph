# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider ---
# Groq is the primary/default provider (free tier available).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Budgets / limits ---
# Soft ceiling on LLM calls per pipeline run. The pipeline should stop
# and report rather than exceed this.
CARTOGRAPH_MAX_LLM_CALLS_PER_RUN=25

# Hard ceiling on LLM calls for a single plan step (Rewriter diagnosis +
# Adjudicator). Independent safety net against routing bugs that could
# otherwise loop a step indefinitely.
CARTOGRAPH_MAX_LLM_CALLS_PER_STEP=4

# Soft ceiling on tokens packed into a single context window sent to a model.
CARTOGRAPH_MAX_CONTEXT_TOKENS=8000

# --- Test runner ---
# Timeout (seconds) for a single `run_tests()` invocation.
CARTOGRAPH_TEST_TIMEOUT_SECONDS=120

# --- Logging ---
CARTOGRAPH_LOG_LEVEL=INFO
